---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Astronauta — OKF Admin Panel" } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-900 text-slate-100 flex flex-col min-h-screen">
    <header class="border-b border-slate-800 bg-slate-950/80 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl w-full min-w-0 mx-auto px-4 sm:px-6 lg:px-8 min-h-16 py-3 sm:py-0 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-0">
        <div class="flex items-center space-x-3 min-w-0">
          <a href="/" class="flex items-center space-x-3 group min-w-0">
            <span class="text-2xl shrink-0">👩‍🚀</span>
            <span class="font-bold text-xl tracking-tight bg-gradient-to-r from-sky-400 to-purple-400 bg-clip-text text-transparent group-hover:opacity-90">Astronauta</span>
          </a>
          <span class="px-2 py-0.5 text-xs font-semibold rounded bg-slate-800 text-slate-400 border border-slate-700 shrink-0">OKF v0.2</span>
        </div>

        <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 min-w-0 sm:flex-nowrap" aria-label="Navegação principal">
          <a href="/" class="text-sm font-medium text-slate-300 hover:text-sky-400 transition-colors">Dashboard</a>
          <a href="/types" class="text-sm font-medium text-slate-300 hover:text-sky-400 transition-colors">Tipos</a>
          <a href="/concepts" class="text-sm font-medium text-slate-300 hover:text-sky-400 transition-colors">Conceitos</a>
          <a href="/editor" class="text-sm font-medium text-slate-300 hover:text-sky-400 transition-colors">Editor</a>
          <a href="/import" class="text-sm font-medium text-slate-300 hover:text-sky-400 transition-colors">Importar</a>
          <a href="/apply" class="text-sm font-medium text-slate-300 hover:text-sky-400 transition-colors">Apply</a>
          <a href="/graph" class="text-sm font-medium text-slate-300 hover:text-sky-400 transition-colors">Grafo</a>
          <a href="/diagnostics" class="text-sm font-medium text-slate-300 hover:text-sky-400 transition-colors">Diagnósticos</a>
        </nav>
      </div>
    </header>

    <main class="flex-grow max-w-7xl w-full min-w-0 mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <footer class="border-t border-slate-800 bg-slate-950 py-6 text-center text-xs text-slate-500">
      <div class="max-w-7xl mx-auto px-4">
        Astronauta · apresentação e interação sobre a autoridade semântica do <a href="https://github.com/franklinbaldo/okf-parser" class="text-sky-400 hover:underline">okf-parser</a>
      </div>
    </footer>
  </body>
</html>
