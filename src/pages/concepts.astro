---
import Layout from '../layouts/Layout.astro';
import { okf } from '../lib/server/okf';

const selectedType = Astro.url.searchParams.get('type') || undefined;
const [concepts, graph] = await Promise.all([okf.concepts(selectedType), okf.graph()]);
const incoming = new Map<string, number>();
const outgoing = new Map<string, number>();
const conceptHref = (id: string) => `/concepts/${id.split('/').map(encodeURIComponent).join('/')}`;
for (const edge of graph.edges) {
  outgoing.set(edge.source_id, (outgoing.get(edge.source_id) || 0) + 1);
  if (edge.target_id) incoming.set(edge.target_id, (incoming.get(edge.target_id) || 0) + 1);
}
---

<Layout title="Explorador de Conceitos — Astronauta">
  <div class="space-y-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-slate-100 tracking-tight">Conceitos OKF</h1>
        <p class="text-slate-400 text-sm mt-1">
          {selectedType ? `Tipo authored: ${selectedType}` : 'Coleção canônica viva'} · {concepts.length} conceito(s)
        </p>
      </div>
      {selectedType && <a href="/concepts" class="text-xs font-semibold text-sky-400 hover:underline">Limpar tipo</a>}
    </div>

    <div class="glass-card p-4 flex gap-4">
      <input type="text" id="search" placeholder="Buscar por ID, título, caminho ou tipo..." class="w-full bg-slate-950 border border-slate-700 rounded px-4 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-sky-400" />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="concepts-grid">
      {concepts.map((concept) => (
        <article class="glass-card p-5 flex flex-col justify-between concept-card space-y-3" data-id={concept.id} data-type={concept.type} data-title={concept.title || ''} data-path={concept.path}>
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <a href={`/types/${encodeURIComponent(concept.type)}`} class="badge badge-purple font-mono text-xs hover:opacity-80">{concept.type}</a>
              <span class="text-xs text-slate-500 font-mono truncate">{concept.path}</span>
            </div>
            <h3 class="text-base font-bold line-clamp-2"><a href={conceptHref(concept.id)} class="text-slate-200 hover:text-sky-400 transition-colors">{concept.title || concept.id}</a></h3>
            <p class="text-xs text-slate-400 font-mono mt-1 break-all">ID: {concept.id}</p>
          </div>
          <div class="pt-3 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
            <span>Entrada: <strong class="text-sky-400">{incoming.get(concept.id) || 0}</strong></span>
            <span>Saída resolvida: <strong class="text-purple-400">{outgoing.get(concept.id) || 0}</strong></span>
          </div>
        </article>
      ))}
    </div>
  </div>

  <script>
    const searchInput = document.getElementById('search') as HTMLInputElement;
    const cards = document.querySelectorAll('.concept-card');
    searchInput?.addEventListener('input', (event) => {
      const query = (event.target as HTMLInputElement).value.toLowerCase();
      cards.forEach((card) => {
        const haystack = [card.getAttribute('data-id'), card.getAttribute('data-title'), card.getAttribute('data-type'), card.getAttribute('data-path')].filter(Boolean).join(' ').toLowerCase();
        (card as HTMLElement).style.display = haystack.includes(query) ? 'flex' : 'none';
      });
    });
  </script>
</Layout>
